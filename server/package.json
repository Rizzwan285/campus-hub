{
  "name": "campus-hub-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the IIT Palakkad Campus Hub",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit",
    "set-admin": "tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "tsx": "^4.20.6",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
