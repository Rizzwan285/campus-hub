# Copy to server/.env and fill in. Never commit the filled-in version.

# Supabase → Project Settings → Database → Connection pooling.
# Port 6543 = transaction pooler (runtime). Port 5432 = session pooler (migrations).
# URL-encode special characters in the password (! becomes %21, @ becomes %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

PORT=4000

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:8080,https://<your-frontend-domain>

# Shared secret for admin write endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=<random-hex-string>

# Signs session tokens. Changing it signs every user out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<random-hex-string-at-least-32-chars>

# Days a session survives without being used.
SESSION_DAYS=30

# Roll number granted developer/admin rights.
ADMIN_ROLL_NUMBER=<your-roll-number>

# ---- Semester importer -------------------------------------------------
# Python 3 interpreter used to parse uploaded workbooks (standard library
# only, no pip packages). If the host has none, /admin offers "upload parsed
# JSON" instead - run scripts/pipeline/import_semester.py on your own machine.
PYTHON_BIN=python3

# ---- Email to you when a student files a timetable change request ------
# resend | brevo  send over HTTPS (free hosts block SMTP ports)
# log             prints the email to the server log instead (local testing)
# none            no email; requests still appear in /admin -> Requests
EMAIL_PROVIDER=none
# API key from the provider's dashboard.
EMAIL_API_KEY=
# A sender address the provider has verified.
EMAIL_FROM="Campus Companion <alerts@example.com>"
# Where the notifications go.
ADMIN_NOTIFY_EMAIL=
# Public URL of the web app, used for the "Review" link in the email.
APP_URL=https://your-app.vercel.app
