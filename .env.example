# Frontend (Vite) environment. Copy to .env and fill in.
# WARNING: every VITE_* value is inlined into the public JS bundle.
# Never put the database password or the service role key in this file.

VITE_API_URL=http://localhost:4000

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
